<%- include('../partials/header') %>
<main>
  <h1><%= title %></h1>

  <div class="detail-container">
    <div class="detail-header">
      <h2><%= project.title %></h2>
      <% if (user && user.role_name === 'admin') { %>
      <a href="/projects/<%= project.project_id %>/edit" class="edit-link">Edit</a>
      <% } %>
    </div>

    <div class="detail-section">
      <h3>Description</h3>
      <div class="description"><%= project.description %></div>
    </div>

    <div class="detail-section">
      <h3>Project Details</h3>
      <div class="metadata">
        <div class="metadata-item">
          <span class="metadata-label">Location:</span>
          <span class="metadata-value"><%= project.location %></span>
        </div>

        <div class="metadata-item">
          <span class="metadata-label">Date:</span>
          <span class="metadata-value">
            <% let projectDate = new Date(project.date); %> <%= projectDate.toLocaleDateString("en-US", { year:
            "numeric", month: "long", day: "numeric" }) %>
          </span>
        </div>

        <div class="metadata-item">
          <span class="metadata-label">Organization:</span>
          <span class="metadata-value">
            <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>
          </span>
        </div>

        <% if (isLoggedIn) { %>
        <div class="metadata-item">
          <span class="metadata-label">Volunteer:</span>
          <span class="metadata-value">
            <% if (!isVolunteered) { %>
            <span class="not-volunteered">You have not volunteered for this project.</span>
            <% } else { %>
            <span class="volunteered">You have volunteered for this project.</span>
            <% } %>
          </span>
        </div>
        <% } %>
      </div>
    </div>

    <% if (isLoggedIn) { %>
    <div class="volunteer-section">
      <% if (!isVolunteered) { %>
      <form action="/projects/<%= project.project_id %>/volunteer" method="POST">
        <button type="submit">Volunteer for this project</button>
      </form>
      <% } else { %>
      <form action="/projects/<%= project.project_id %>/resign" method="POST">
        <button type="submit">Resign from this project</button>
      </form>
      <% } %>
    </div>
    <% } %>

    <div class="detail-section">
      <h3>Categories</h3>

      <% if (user && user.role_name === 'admin') { %>
      <a href="/categories/<%= project.project_id %>/assign">Edit Categories</a>
      <% } %>

      <% if (categories && categories.length > 0) { %>
      <div class="category-tags">
        <% categories.forEach(category => { %>
        <a href="/categories/<%= category.category_id %>" class="category-tag"> <%= category.name %> </a>
        <% }); %>
      </div>
      <% } else { %>
      <div class="empty-state">No categories assigned to this project.</div>
      <% } %>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
