<%- include('../partials/header') %>
<main>
  <h1><%= title %></h1>

  <div class="detail-container">
    <div class="detail-header">
      <h2><%= userDetails.name %></h2>
      <% if (user && user.role_name === 'admin') { %>
      <a href="/users/<%= userDetails.user_id %>/edit">Edit</a>
      <% } %>
    </div>

    <div class="user-details">
      <h3>User Details</h3>

      <div class="user-details-section">
        <p>
          <strong>Email:</strong>
          <%= userDetails.email %>
        </p>
        <p>
          <strong>Role:</strong>
          <%= userDetails.role_name %>
        </p>
        <p>
          <strong>Created at:</strong>
          <%= new Date(userDetails.created_at).toLocaleDateString("en-US", { year: "numeric", month: "long", day:
      "numeric" }) %>
        </p>
        <p>
          <% if (user && user.role_name === 'admin') { %>
          <a class="change-password-link" href="/users/<%= userDetails.user_id %>/password">Change Password</a>
          <% } %>
        </p>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
